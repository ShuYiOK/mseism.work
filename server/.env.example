# 服务器配置
PORT=3001

# 数据库配置
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=mseism

# 外部设备数据源 API
DEVICE_API_URL=http://your-device-api-url/devices/list

# 数据同步配置
SYNC_INTERVAL=5000
OFFLINE_THRESHOLD=300
API_TIMEOUT=10000

# WebSocket 配置
WS_PING_TIMEOUT=60000
WS_PING_INTERVAL=25000

# JWT 认证配置（请使用 openssl rand -hex 64 生成随机密钥）
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# 密码加密配置
BCRYPT_ROUNDS=12

# CORS 配置（逗号分隔的允许的源）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000

# 安全配置
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=30

# 初始管理员密码（首次部署后请立即修改）
INITIAL_ADMIN_PASSWORD=change_me_immediately

# 初始超级管理员（root）密码（首次部署后请立即修改）
INITIAL_ROOT_PASSWORD=change_me_immediately

# 性能监控配置
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_ALERT_THRESHOLD=1000
SYNC_ALERT_THRESHOLD=5000

# 日志配置
LOG_LEVEL=info
ENABLE_ACCESS_LOG=true
ENABLE_ERROR_LOG=true
ENABLE_OPERATION_LOG=true

# 速率限制配置
API_RATE_LIMIT_WINDOW=60000
API_RATE_LIMIT_MAX=100
SYNC_RATE_LIMIT_WINDOW=60000
SYNC_RATE_LIMIT_MAX=10

# 环境配置
NODE_ENV=production

# 「记录下载」功能配置
# 导出文件根目录（相对于 server 目录；建议挂载为持久化 volume）
DOWNLOADS_DIR=./data/downloads
# 文件保留天数（超过则自动清理）
DOWNLOAD_RETENTION_DAYS=365
# 每日变化检查的 cron 表达式（默认每天 0:05）
DOWNLOAD_CRON_EXPRESSION=5 0 * * *
# 地图截图瓦片源（默认高德卫星图 style=6；可改为矢量 style=8）
MAP_TILE_URL=https://webst0{s}.is.autonavi.com/appmaptile?style=6&x={x}&y={y}&z={z}
MAP_TILE_SUBDOMAINS=1,2,3,4
# 单张瓦片请求超时（毫秒）
MAP_TILE_TIMEOUT=8000
# 瓦片并发抓取数（避免触发瓦片源限流）
MAP_TILE_MAX_CONCURRENCY=4
# 单张瓦片失败重试次数
MAP_TILE_RETRY=2
# 截图输出宽度（像素，高度按设备范围自适应）
MAP_IMAGE_WIDTH=1200
