# 生产环境配置
NODE_ENV=production

# 服务器端口
PORT=3001

# 数据库路径
DB_PATH=/app/database/mseism.db

# 外部设备数据源 API
DEVICE_API_URL=http://124.238.104.120:81/devices/list

# 数据同步配置（毫秒）
SYNC_INTERVAL=5000
OFFLINE_THRESHOLD=300
API_TIMEOUT=10000

# WebSocket 配置（毫秒）
WS_PING_TIMEOUT=60000
WS_PING_INTERVAL=25000

# JWT 认证配置（⚠️ 生产环境务必修改）
JWT_SECRET=your-production-jwt-secret-key-change-this-now
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# 密码加密轮次
BCRYPT_ROUNDS=12

# CORS 允许的来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost,http://你的服务器 IP,http://你的域名

# 安全配置
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=30

# 性能监控
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_ALERT_THRESHOLD=1000
SYNC_ALERT_THRESHOLD=5000

# 日志配置
LOG_LEVEL=info
ENABLE_ACCESS_LOG=true
ENABLE_ERROR_LOG=true
ENABLE_OPERATION_LOG=true

# 速率限制（毫秒，次数）
API_RATE_LIMIT_WINDOW=60000
API_RATE_LIMIT_MAX=100
SYNC_RATE_LIMIT_WINDOW=60000
SYNC_RATE_LIMIT_MAX=10
