# MseisM 环境变量模板
# 
# 复制此文件为 .env 并填写真实值：
#   cp .env.example .env
#
# ⚠️  .env 已加入 .gitignore，绝不提交到 Git！
# ⚠️  生产密钥请通过 GitHub Secrets 注入

# ── 服务器配置 ─────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── MySQL 数据库 ───────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mseism
DB_USER=mseism
DB_PASSWORD=your_db_password_here
DB_ROOT_PASSWORD=your_root_password_here

# ── JWT 认证 ────────────────────────────────────────────
# 生成强密钥: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_at_least_32_chars_here
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ── 外部设备数据源 ─────────────────────────────────────
DEVICE_API_URL=http://124.238.104.120:81/devices/list
API_TIMEOUT=10000

# ── CORS 配置 ──────────────────────────────────────────
# 多个地址用逗号分隔
ALLOWED_ORIGINS=http://localhost,http://your-server-ip

# ── 端口映射（Docker Compose）──────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=80

# ── 镜像版本（CI/CD 自动更新）─────────────────────────
BACKEND_IMAGE=ghcr.io/your-org/mseism-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/mseism-frontend:latest

# ── 数据同步 ────────────────────────────────────────────
SYNC_INTERVAL=5000
OFFLINE_THRESHOLD=300

# ── 安全配置 ────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=30

# ── 性能监控 ────────────────────────────────────────────
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_ALERT_THRESHOLD=1000

# ── 日志配置 ────────────────────────────────────────────
LOG_LEVEL=info
ENABLE_ACCESS_LOG=true
ENABLE_ERROR_LOG=true
ENABLE_OPERATION_LOG=true

# ── WebSocket ──────────────────────────────────────────
WS_PING_TIMEOUT=120000
WS_PING_INTERVAL=60000

# ── 速率限制 ────────────────────────────────────────────
API_RATE_LIMIT_WINDOW=60000
API_RATE_LIMIT_MAX=100
